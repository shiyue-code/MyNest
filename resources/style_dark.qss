/* Global application background and defaults - Dark Theme */
QWidget {
    background: #0F172A;
    color: #F1F5F9;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    font-size: 13px;
}

QLabel {
    background: transparent;
    color: #F1F5F9;
}

/* Card-like panels and bars */
QFrame#toolbar, QFrame#statusBar, QFrame#panel {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}

QFrame#statusCardRow {
    background: transparent;
    border: none;
}

QFrame#toolbar {
    border-radius: 0;
    border-left: none;
    border-right: none;
    border-top: none;
    border-bottom: 1px solid #334155;
}

QFrame#canvasFrame, QFrame#viewportPanel {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}

QLabel#viewportTitle {
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#sectionTitle {
    color: #F8FAFC;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

/* Buttons */
QPushButton {
    background: #1E293B;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 7px 12px;
    min-height: 22px;
    color: #E2E8F0;
    font-weight: 500;
}

QPushButton:hover {
    background: #334155;
    border-color: #64748B;
}

QPushButton:pressed {
    background-color: #475569;
}

/* Custom button roles */
QPushButton[role='primary'] {
    background: #0D9488;
    color: white;
    border: none;
    font-weight: 600;
}

QPushButton[role='primary']:hover {
    background: #0F766E;
}

QPushButton[role='primary']:pressed {
    background: #115E59;
}

QPushButton[role='accent'] {
    background: #0D9488;
    color: white;
    border: none;
}

QPushButton[role='accent']:hover {
    background: #0F766E;
}

QPushButton[role='accent']:pressed {
    background: #115E59;
}

QPushButton[role='danger'] {
    color: #F87171;
    border: 1px solid #7F1D1D;
    background: #1E293B;
}

QPushButton[role='danger']:hover {
    background: #7F1D1D;
    border-color: #EF4444;
    color: white;
}

QPushButton[role='danger']:pressed {
    background: #991B1B;
}

/* Combo Box */
QComboBox {
    background: #1E293B;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 5px 30px 5px 8px;
    min-height: 24px;
    color: #F1F5F9;
}

QComboBox:hover {
    border-color: #64748B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/arrow_down.xpm);
    width: 9px;
    height: 9px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background: #1E293B;
    border: 1px solid #475569;
    border-radius: 6px;
    selection-background-color: #334155;
    selection-color: #2DD4BF;
    outline: none;
    padding: 4px;
    color: #F1F5F9;
}

/* Spin boxes */
QSpinBox, QDoubleSpinBox {
    background: #1E293B;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 5px 24px 5px 8px;
    min-height: 24px;
    color: #F1F5F9;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #64748B;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/arrow_up.xpm);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/arrow_down.xpm);
    width: 9px;
    height: 9px;
}

/* Checkbox */
QCheckBox {
    background: transparent;
    spacing: 8px;
    color: #F1F5F9;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #475569;
    background: #1E293B;
}

QCheckBox::indicator:hover {
    border-color: #0D9488;
}

QCheckBox::indicator:checked {
    border: 1px solid #0D9488;
    background: #0D9488;
}

/* Table Widget */
QTableWidget {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    gridline-color: transparent;
    alternate-background-color: #1A2230;
    selection-background-color: #134E4A;
    selection-color: #2DD4BF;
    show-decoration-selected: 1;
    color: #F1F5F9;
}

QHeaderView::section {
    background: #111827;
    color: #94A3B8;
    border: none;
    border-bottom: 1px solid #334155;
    padding: 7px;
    font-weight: 600;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* ScrollBars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 0 4px 0;
}

QScrollBar::handle:vertical {
    background: #475569;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 4px 0 4px;
}

QScrollBar::handle:horizontal {
    background: #475569;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #64748B;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Progress Bar */
QProgressBar {
    background: #334155;
    border: none;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
    text-align: center;
    color: #F1F5F9;
    font-size: 11px;
    font-weight: 600;
}

QProgressBar::chunk {
    background: #0D9488;
    border-radius: 8px;
}

/* Shape Cards & Lists */
QFrame#cardListSurface {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}

QFrame#shapeCard {
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
}

QFrame#shapeCard:hover {
    border-color: #0D9488;
    background-color: #1E293B;
}

QFrame#resultCard {
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
}

QLabel#cardTitle {
    color: #F1F5F9;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#cardMeta {
    color: #94A3B8;
    font-size: 12px;
    background: transparent;
}

QLabel#cardBadge {
    color: #E2E8F0;
    background: #334155;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 12px;
}

QLabel#shapeThumb {
    background: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
}

QProgressBar#miniProgress {
    background: #334155;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}

QProgressBar#miniProgress::chunk {
    background: #0D9488;
    border-radius: 3px;
}

QFrame#statusCard {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}

QLabel#statusTitle {
    color: #94A3B8;
    font-size: 12px;
    background: transparent;
}

QLabel#statusValue {
    color: #F1F5F9;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

/* Color Strip on Cards - Unified with dynamic properties */
QFrame#colorStrip {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
}

QFrame#colorStrip[colorIndex="0"] { background-color: rgba(76, 120, 168, 200); }
QFrame#colorStrip[colorIndex="1"] { background-color: rgba(245, 133, 24, 200); }
QFrame#colorStrip[colorIndex="2"] { background-color: rgba(84, 162, 75, 200); }
QFrame#colorStrip[colorIndex="3"] { background-color: rgba(228, 87, 86, 200); }
QFrame#colorStrip[colorIndex="4"] { background-color: rgba(114, 183, 178, 200); }
QFrame#colorStrip[colorIndex="5"] { background-color: rgba(178, 121, 162, 200); }
QFrame#colorStrip[colorIndex="6"] { background-color: rgba(255, 157, 166, 200); }
QFrame#colorStrip[colorIndex="7"] { background-color: rgba(157, 117, 93, 200); }

/* Overlay tooltip on canvas */
QLabel#metricOverlay {
    background-color: rgba(30, 41, 59, 214);
    border: 1px solid #475569;
    color: #F1F5F9;
}
